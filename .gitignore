# ==========================================
# Android & Kotlin .gitignore
# ==========================================

# Built application files
*.apk
*.aar
*.ap_
*.aab
*.dex

# Files for the ART/Dalvik VM
*.class

# Java / JVM crash logs
hs_err_pid*
replay_pid*

# Gradle cache and generated files
.gradle/
build/
**/build/
.kotlin/

# Local configuration file (sdk path, api keys, etc)
local.properties

# Proguard / R8 output
proguard/
**/proguard/

# Android Studio / IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/
out/

# Android Studio Navigation Editor
.idea/navEditor.xml

# Android Studio Asset Studio
.idea/assetWizardSettings.xml

# Keystore / Signing files (Security)
*.jks
*.keystore
*.p12
*.key
key.properties

# Google Services / Crashlytics keys (if added in future)
# google-services.json

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Android Profiling & Captures
/captures/
**/captures/

# C++ / NDK builds
.externalNativeBuild/
.cxx/

# Agent plans (local only, never commit)
.agent/
log.txt
