# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.kt text diff=kotlin
*.kts text diff=kotlin
*.java text diff=java
*.xml text diff=xml
*.json text
*.md text
*.properties text
*.pro text
*.gradle text
*.gradle.kts text

# Shell scripts must always use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - denote that these files are binary and should not be modified
*.jar binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
